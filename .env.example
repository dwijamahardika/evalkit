# Copy to .env and fill in only what you use. Never commit real values.
# The demo and the test suite need none of these: they run on the offline `fake` provider.

# provider: anthropic (read by the official SDK)
ANTHROPIC_API_KEY=

# provider: openai (generic OpenAI-compatible endpoint; the variable name is configurable
# per suite via `api_key_env`)
OPENAI_API_KEY=

# where cached responses live (default: .evalkit-cache in the working directory)
EVALKIT_CACHE_DIR=
